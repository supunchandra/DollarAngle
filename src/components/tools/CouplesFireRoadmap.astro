---
const { compact=false }=Astro.props;
---
<section class:list={['fire-tool',{compact}]} data-fire-tool aria-label="Couples financial independence retirement roadmap">
<header><p class="eyebrow">DOLLARANGLE · MONEY TOOLS</p><h2>Your roadmap to financial independence, together.</h2><p>Choose a sustainable household budget, savings plan, and target withdrawal rate to explore when investments might cover your expenses.</p></header>
<div class="layout"><form data-form class="inputs">
<label>Currency<select data-currency><option value="USD">USD $</option><option value="GBP">GBP £</option><option value="EUR">EUR €</option></select></label>
<label>Partner A annual take-home income<input data-a type="number" min="0" max="1000000000" step="100" value="85000"/></label>
<label>Partner B annual take-home income<input data-b type="number" min="0" max="1000000000" step="100" value="55000"/></label>
<label>Annual household spending<input data-spending type="number" min="0" max="1000000000" step="100" value="80000"/></label>
<label>Current invested assets<input data-assets type="number" min="0" max="100000000000" step="100" value="150000"/></label>
<label>Monthly additional savings (+) or withdrawals (-)<input data-adjust type="number" min="-10000000" max="10000000" step="50" value="0"/></label>
<label>Annual investment return before inflation (%)<input data-growth type="number" min="-10" max="20" step=".5" value="6"/></label>
<label>Annual inflation (%)<input data-inflation type="number" min="0" max="15" step=".5" value="2.5"/></label>
<label>Target withdrawal rate (%)<input data-withdraw type="number" min="1" max="8" step=".25" value="4"/></label>
<label>Projection horizon (years)<input data-horizon type="number" min="1" max="70" step="1" value="45"/></label>
<p class="hint">All cash amounts use the same currency. Currency selection only changes formatting. Income and spending are annual take-home amounts; additional monthly savings adjusts the normal income-minus-spending surplus. Investments grow at a constant illustrative nominal return. Contributions and the target are evaluated in today's purchasing power, using the derived real return. Taxes on investment withdrawals, fees, pensions and Social Security are excluded.</p>
</form>
<section class="results" aria-live="polite" aria-atomic="true"><p class="eyebrow">YOUR COUPLES' FIRE PLAN</p><p data-error class="error" hidden></p><div data-output>
<div class="hero"><small>Your financial independence target</small><strong data-target></strong><span>Today's annual spending ÷ selected withdrawal rate</span></div>
<div class="cards"><div><small>Projected years until FIRE</small><strong data-years></strong></div><div><small>Monthly investment contribution</small><strong data-saving></strong></div><div><small>Household savings rate</small><strong data-rate></strong></div><div><small>Real annual return assumption</small><strong data-real></strong></div></div>
<h3>Invested assets over time, in today's money</h3><div class="chart" data-chart role="img" aria-label="Projected investment balance by year"></div><div class="axis"><span>Now</span><span data-axis></span></div><p data-explain class="hint"></p><button type="button" class="copy" data-copy>Copy FIRE roadmap</button><span data-status class="hint" role="status"></span>
</div></section></div></section>
<style>
.fire-tool{color:#17382d;font-family:Inter,system-ui,sans-serif;background:#fff;border:1px solid #d8eadd;border-radius:25px;padding:clamp(18px,3vw,34px)}.fire-tool header{max-width:780px;margin-bottom:24px}.fire-tool .eyebrow{font-size:.7rem;letter-spacing:.1em;font-weight:850;color:#087c61;margin:0}.fire-tool h2{font-size:clamp(1.55rem,3vw,2.2rem);letter-spacing:-.04em;line-height:1.15;margin:10px 0}.fire-tool header p:not(.eyebrow){color:#5c7667;line-height:1.65}.fire-tool .layout{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.04fr);gap:24px}.fire-tool .inputs{display:grid;grid-template-columns:1fr 1fr;gap:13px;align-content:start}.fire-tool .inputs label{display:grid;gap:7px;min-width:0;font-size:.79rem;font-weight:730}.fire-tool input,.fire-tool select{width:100%;min-width:0;padding:11px;border:1px solid #c7dece;border-radius:10px;color:#16372a;font:inherit;background:white}.fire-tool .hint{grid-column:1/-1;font-size:.76rem;color:#657d6e;line-height:1.65}.fire-tool .results{border-radius:19px;border:1px solid #d8eadd;background:#f0faf4;padding:20px;min-width:0}.fire-tool .hero{background:#087c61;border-radius:14px;padding:19px;display:grid;gap:9px;color:#fff;margin:15px 0}.fire-tool .hero small,.fire-tool .hero span{color:#dff7e7}.fire-tool .hero strong{font-size:clamp(1.55rem,3vw,2.1rem);overflow-wrap:anywhere}.fire-tool .hero span{font-size:.73rem}.fire-tool .cards{display:grid;grid-template-columns:1fr 1fr;gap:10px}.fire-tool .cards>div{min-width:0;display:grid;gap:8px;background:white;padding:13px;border:1px solid #d8eade;border-radius:12px}.fire-tool .cards small{font-size:.74rem;color:#5f7867}.fire-tool .cards strong{font-size:clamp(.98rem,2vw,1.3rem);overflow-wrap:anywhere}.fire-tool h3{font-size:.91rem;margin:24px 0 14px}.fire-tool .chart{height:145px;display:flex;align-items:end;gap:3px;border-bottom:1px solid #afd4bc}.fire-tool .chart span{flex:1;min-width:1px;background:#62b898;border-radius:2px 2px 0 0}.fire-tool .axis{display:flex;justify-content:space-between;color:#677e70;font-size:.72rem;margin:6px 0 15px}.fire-tool .copy{border:0;border-radius:11px;background:#087c61;color:white;font-weight:800;padding:12px 17px;cursor:pointer}.fire-tool .error{color:#a82f42}.fire-tool [hidden]{display:none!important}.fire-tool :focus-visible{outline:3px solid #91dab6;outline-offset:2px}@media(max-width:820px){.fire-tool .layout{grid-template-columns:1fr}}@media(max-width:440px){.fire-tool .inputs{grid-template-columns:1fr}.fire-tool .results{padding:15px}}
</style>
<script>
function initFire(root:Element){
 if(root.hasAttribute('data-fire-ready'))return;root.setAttribute('data-fire-ready','true');
 const get=(k:string)=>root.querySelector<HTMLInputElement>('[data-'+k+']')!;
 const out=(k:string)=>root.querySelector<HTMLElement>('[data-'+k+']')!;
 let copied='';
 function update(){
  const keys=['a','b','spending','assets','adjust','growth','inflation','withdraw','horizon'];
  const v=keys.map(k=>get(k).valueAsNumber);
  const [a,b,spending,assets,adjust,growth,inflation,withdraw,horizon]=v;
  const valid=v.every(Number.isFinite)&&a>=0&&b>=0&&a<=1e9&&b<=1e9&&spending>0&&spending<=1e9&&assets>=0&&assets<=1e11&&adjust>=-1e7&&adjust<=1e7&&growth>=-10&&growth<=20&&inflation>=0&&inflation<=15&&withdraw>=1&&withdraw<=8&&Number.isInteger(horizon)&&horizon>=1&&horizon<=70;
  const savings=(a+b-spending)/12+adjust;
  const rate=(a+b)>0?100*savings*12/(a+b):null;
  out('error').hidden=valid;out('output').hidden=!valid;
  if(!valid){out('error').textContent='Enter positive spending and valid incomes, investments, return rates, and projection horizon.';return;}
  const money=(n:number)=>new Intl.NumberFormat('en-US',{style:'currency',currency:get('currency').value,maximumFractionDigits:0}).format(n);
  const target=spending/(withdraw/100);
  // Convert the annual nominal growth rate and inflation to a real monthly investment rate.
  const realAnnual=(1+growth/100)/(1+inflation/100)-1;
  const monthlyReal=Math.pow(1+realAnnual,1/12)-1;
  let balance=assets,hit=balance>=target?0:-1;
  const balances=[balance];
  for(let m=1;m<=horizon*12;m++){
   balance=balance*(1+monthlyReal)+savings;
   if(hit<0&&balance>=target)hit=m;
   if(m%12===0)balances.push(Math.max(balance,0));
  }
  out('target').textContent=money(target);
  out('years').textContent=hit<0?'Not within '+horizon+' years':hit===0?'Already at target':(hit/12).toFixed(1)+' years';
  out('saving').textContent=money(savings);
  out('rate').textContent=rate===null?'N/A':rate.toFixed(1)+'%';
  out('real').textContent=(100*realAnnual).toFixed(2)+'%';
  out('axis').textContent='Year '+horizon;
  const chart=out('chart');chart.replaceChildren();const max=Math.max(target,...balances,1);
  balances.forEach(b=>{const el=document.createElement('span');el.style.height=Math.max(1,Math.min(100,b/max*100))+'%';chart.append(el);});
  out('explain').textContent=(savings<0?'Your modeled monthly withdrawals reduce the invested portfolio. ':'The projection assumes the same monthly contribution throughout. ')+(hit<0?'The portfolio does not reach the target within the selected horizon.':'The estimated target is reached using a fixed withdrawal-rate rule of thumb, not a guaranteed sustainable retirement.')+' The chart is inflation-adjusted; it does not simulate investment volatility.';
  copied='DollarAngle Couples FIRE Roadmap\nTarget: '+money(target)+'\nMonthly savings: '+money(savings)+'\nEstimated FIRE timeline: '+out('years').textContent+'\nIllustrative real annual return: '+(100*realAnnual).toFixed(2)+'%\nNot a guarantee or financial advice. dollarangle.com/tools/couples-fire-calculator';
 }
 root.addEventListener('input',update);root.addEventListener('change',update);
 root.querySelector('[data-copy]')!.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(copied);out('status').textContent='Copied!';}catch{out('status').textContent='Copy unavailable in this browser.';}});
 update();
}
document.querySelectorAll('[data-fire-tool]').forEach(initFire);
document.addEventListener('astro:page-load',()=>document.querySelectorAll('[data-fire-tool]').forEach(initFire));
</script>