---
const { compact=false }=Astro.props;
---
<section class:list={['break-tool',{compact}]} data-break-tool aria-label="Career break and maternity leave financial impact calculator">
<header><p class="eyebrow">DOLLARANGLE MONEY TOOLS</p><h2>The financial picture of taking time away from work</h2><p>Estimate pay during leave, avoided work expenses and the long-term opportunity cost of missed retirement contributions.</p></header>
<div class="layout"><form class="inputs" data-form>
<label>Currency<select data-currency><option value="USD">USD $</option><option value="GBP">GBP £</option><option value="EUR">EUR €</option></select></label>
<label>Annual gross salary<input data-salary type="number" min="0" max="100000000" value="70000" step="100"/></label>
<label>Estimated effective income/payroll deduction (%)<input data-tax type="number" min="0" max="90" value="24" step=".5"/></label>
<label>Career break length (months)<input data-months type="number" min="1" max="120" value="12" step="1"/></label>
<label>Paid leave months (within break)<input data-paidmonths type="number" min="0" max="120" value="3" step="1"/></label>
<label>Pay received during paid leave (% of normal gross)<input data-payrate type="number" min="0" max="100" value="60" step="1"/></label>
<label>Monthly childcare costs avoided while on leave<input data-care type="number" min="0" max="1000000" value="900" step="50"/></label>
<label>Other monthly work costs avoided<input data-work type="number" min="0" max="1000000" value="250" step="50"/></label>
<label>Employee retirement contribution (% of gross)<input data-employee type="number" min="0" max="100" value="5" step=".5"/></label>
<label>Employer retirement contribution (% of gross)<input data-employer type="number" min="0" max="100" value="4" step=".5"/></label>
<label>Years until retirement<input data-years type="number" min="0" max="60" value="25" step="1"/></label>
<label>Illustrative annual investment growth (%)<input data-growth type="number" min="0" max="15" value="5" step=".5"/></label>
<p class="hint">Assumes an unchanged salary and effective deduction rate, paid leave at the beginning of the break, and no retirement contributions during unpaid months. Paid leave retirement contributions are estimated at the paid percentage; employer plans may differ. Savings from avoided costs are counted in cash but not automatically invested. Inputs are in one selected currency; changing its label does not convert values.</p>
</form><div class="results" aria-live="polite" aria-atomic="true"><p class="eyebrow">YOUR CAREER BREAK SCENARIO</p><p class="error" data-error hidden></p><div data-output><div class="hero"><small>Estimated immediate net cash impact</small><strong data-net></strong><span>After paid leave income and avoided work/childcare costs</span></div><div class="cards"><div><small>Take-home pay forgone</small><strong data-forgone></strong></div><div><small>Paid leave take-home</small><strong data-paid></strong></div><div><small>Work and childcare costs avoided</small><strong data-avoided></strong></div><div><small>Retirement contributions missed</small><strong data-missed></strong></div></div><h3>Potential retirement investment value missed</h3><p class="future" data-future></p><p class="hint">Illustrative growth of missed contributions from their assumed payment dates until retirement. This is not an additional current cash loss, guaranteed return or pension forecast.</p><h3>Cash impact breakdown</h3><div class="detail"><span>Full-break normal take-home</span><strong data-normal></strong></div><div class="detail"><span>Take-home during paid leave</span><strong data-paid2></strong></div><div class="detail"><span>Avoided expenses</span><strong data-avoided2></strong></div><button type="button" data-copy class="copy">Copy scenario</button><span data-status class="hint" role="status"></span></div></div></div></section>
<style>.break-tool{font-family:Inter,system-ui,sans-serif;color:#173a2c;background:white;border:1px solid #d8e9de;border-radius:25px;padding:clamp(17px,3vw,34px)}.break-tool header{max-width:780px;margin-bottom:23px}.break-tool .eyebrow{color:#087c61;font-size:.7rem;letter-spacing:.1em;font-weight:850;margin:0}.break-tool h2{font-size:clamp(1.6rem,3vw,2.2rem);letter-spacing:-.04em;line-height:1.15;margin:10px 0}.break-tool header>p:last-child{color:#5d7669;line-height:1.6}.break-tool .layout{display:grid;grid-template-columns:1fr 1fr;gap:23px}.break-tool .inputs{display:grid;grid-template-columns:1fr 1fr;gap:13px;align-content:start}.break-tool .inputs label{display:grid;gap:7px;min-width:0;font-size:.78rem;font-weight:730}.break-tool .inputs input,.break-tool .inputs select{width:100%;min-width:0;border:1px solid #c8ddcf;border-radius:10px;padding:11px;background:white;font:inherit;color:#183a2d}.break-tool .hint{font-size:.76rem;line-height:1.6;color:#657d6f;grid-column:1/-1}.break-tool .results{border:1px solid #d7e9dd;border-radius:19px;background:#f1faf5;padding:20px;min-width:0}.break-tool .hero{display:grid;gap:8px;background:#087c61;border-radius:14px;color:white;padding:19px;margin:15px 0}.break-tool .hero small,.break-tool .hero span{color:#ddf5e7}.break-tool .hero strong{font-size:clamp(1.5rem,2.7vw,2rem);overflow-wrap:anywhere}.break-tool .hero span{font-size:.74rem}.break-tool .cards{display:grid;grid-template-columns:1fr 1fr;gap:10px}.break-tool .cards>div{min-width:0;display:grid;gap:8px;background:white;border:1px solid #d9eadd;border-radius:12px;padding:13px}.break-tool .cards small{color:#607667;font-size:.73rem}.break-tool .cards strong{overflow-wrap:anywhere;font-size:clamp(.98rem,2vw,1.35rem)}.break-tool h3{font-size:.94rem;margin:22px 0 9px}.break-tool .future{font-size:1.65rem;font-weight:800;color:#087c61;margin:5px 0}.break-tool .detail{display:flex;gap:12px;justify-content:space-between;border-bottom:1px solid #d7e8dd;padding:11px 0;font-size:.8rem}.break-tool .copy{border:0;background:#087c61;color:white;padding:12px 17px;border-radius:11px;font-weight:800;cursor:pointer;margin-top:18px}.break-tool .error{color:#ae3446}.break-tool [hidden]{display:none!important}.break-tool :focus-visible{outline:3px solid #90dab6;outline-offset:2px}@media(max-width:800px){.break-tool .layout{grid-template-columns:1fr}}@media(max-width:440px){.break-tool .inputs{grid-template-columns:1fr}.break-tool .results{padding:15px}}
</style>
<script>
function initBreak(root:Element){
 if(root.hasAttribute('data-break-ready'))return;root.setAttribute('data-break-ready','true');
 const get=(k:string)=>root.querySelector<HTMLInputElement>('[data-'+k+']')!;
 const out=(k:string)=>root.querySelector<HTMLElement>('[data-'+k+']')!;
 let clipboard='';
 function recalc(){
  const keys=['salary','tax','months','paidmonths','payrate','care','work','employee','employer','years','growth'];
  const vals=keys.map(k=>get(k).valueAsNumber);
  const [salary,tax,months,paidMonths,payRate,care,work,employee,employer,years,growth]=vals;
  const valid=vals.every(Number.isFinite)&&salary>=0&&salary<=1e8&&tax>=0&&tax<=90&&Number.isInteger(months)&&months>=1&&months<=120&&Number.isInteger(paidMonths)&&paidMonths>=0&&paidMonths<=months&&[payRate,employee,employer].every(n=>n>=0&&n<=100)&&[care,work].every(n=>n>=0&&n<=1e6)&&years>=0&&years<=60&&growth>=0&&growth<=15;
  out('error').hidden=valid;out('output').hidden=!valid;
  if(!valid){out('error').textContent='Check all entries. Paid leave cannot exceed the break length, and percentages must be within their listed ranges.';return;}
  const cash=(n:number)=>new Intl.NumberFormat('en-US',{style:'currency',currency:get('currency').value,maximumFractionDigits:0}).format(n);
  const monthlyGross=salary/12,netRate=1-tax/100,normal=monthlyGross*netRate*months;
  const paid=monthlyGross*netRate*(payRate/100)*paidMonths;
  const lost=normal-paid,avoided=(care+work)*months,impact=lost-avoided;
  const rate=(employee+employer)/100,fullContrib=monthlyGross*rate,paidContrib=fullContrib*payRate/100;
  const missed=fullContrib*(months-paidMonths)+(fullContrib-paidContrib)*paidMonths;
  // Missed contributions are treated as end-of-month contributions, then grown to the selected retirement horizon.
  const monthRate=Math.pow(1+growth/100,1/12)-1;let future=0;
  for(let m=0;m<months;m++){
   const miss=fullContrib-(m<paidMonths?paidContrib:0);
   const monthsToRetire=Math.max(0,years*12-m-1);
   future+=miss*Math.pow(1+monthRate,monthsToRetire);
  }
  out('net').textContent=(impact>=0?'-':'+')+cash(Math.abs(impact));
  out('forgone').textContent=cash(lost);out('paid').textContent=cash(paid);
  out('avoided').textContent=cash(avoided);out('missed').textContent=cash(missed);
  out('future').textContent=cash(future);out('normal').textContent=cash(normal);out('paid2').textContent=cash(paid);out('avoided2').textContent=cash(avoided);
  clipboard='DollarAngle career break estimate ('+get('currency').value+')\nBreak: '+months+' months\nNet cash impact: '+(impact>=0?'-':'+')+cash(Math.abs(impact))+'\nMissed retirement contributions: '+cash(missed)+'\nPotential value by retirement: '+cash(future)+'\nEducational estimate, not tax or pension advice. dollarangle.com/tools/career-break-maternity-leave-calculator';
 }
 root.addEventListener('input',recalc);root.addEventListener('change',recalc);
 root.querySelector('[data-copy]')!.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(clipboard);out('status').textContent='Copied!';}catch{out('status').textContent='Copy unavailable in this browser.';}});
 recalc();
}
document.querySelectorAll('[data-break-tool]').forEach(initBreak);
document.addEventListener('astro:page-load',()=>document.querySelectorAll('[data-break-tool]').forEach(initBreak));
</script>