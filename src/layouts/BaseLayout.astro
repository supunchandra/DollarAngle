---
import Analytics from '@vercel/analytics/astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const {
  title = 'DollarAngle — A smarter angle on your money',
  description = 'DollarAngle explains personal finance, investing, markets and the economy in plain English for people building a stronger financial future.',
  image = '/og-default.png',
  imageAlt = 'DollarAngle — A smarter angle on your money',
  imageWidth = 1200,
  imageHeight = 630,
  imageType = 'image/png',
  type = 'website',
  noindex = false
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
const siteUrl = Astro.site?.toString() ?? 'https://dollarangle.com/';
const organizationId = new URL('/#organization', siteUrl).href;
const websiteId = new URL('/#website', siteUrl).href;
const googleVerification = process.env.GOOGLE_SITE_VERIFICATION;

const siteSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: 'DollarAngle',
      description: 'Financial education and commentary publication.',
      url: siteUrl,
      logo: {
        '@type': 'ImageObject',
        url: new URL('/logo.svg', siteUrl).href
      }
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      name: 'DollarAngle',
      url: siteUrl,
      publisher: { '@id': organizationId }
    }
  ]
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="describedby" href="/llms.txt" type="text/markdown" />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    <meta property="og:site_name" content="DollarAngle" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content={imageType} />
    <meta property="og:image:width" content={imageWidth} />
    <meta property="og:image:height" content={imageHeight} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
    <Analytics />
  </head>
  <body>
    <Header />
    <main><slot /></main>
    <Footer />
    <script is:inline>
      const toggle = document.querySelector('[data-mobile-toggle]');
      const nav = document.querySelector('[data-nav-links]');
      if (toggle && nav) {
        toggle.addEventListener('click', () => {
          const open = nav.dataset.open === 'true';
          nav.dataset.open = String(!open);
          toggle.setAttribute('aria-expanded', String(!open));
        });
      }
      document.querySelectorAll('[data-placeholder-form]').forEach((form) => {
        form.addEventListener('submit', (event) => {
          event.preventDefault();
          const button = form.querySelector('button');
          if (!button) return;
          button.textContent = 'Integration coming next';
          button.disabled = true;
        });
      });
    </script>
  </body>
</html>
