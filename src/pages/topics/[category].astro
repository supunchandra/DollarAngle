---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getVisibleArticles, showDrafts } from '../../lib/content';

export function getStaticPaths() {
  const categories = ['personal-finance','investing','markets','economy','crypto','real-estate','money-relationships'];
  return categories.map((category) => ({ params: { category } }));
}
const { category } = Astro.params;
const label = category === 'money-relationships' ? 'Money & Relationships' : category.replaceAll('-', ' ').replace(/\b\w/g, (c) => c.toUpperCase());
const articles = (await getVisibleArticles()).filter((entry) => entry.data.category === category);
const isRelationships = category === 'money-relationships';
const description = isRelationships
  ? 'Practical money guides for dating, moving in together and marriage: splitting bills fairly, discussing debt, planning shared goals and protecting financial independence.'
  : `DollarAngle ${label} guides and analysis in plain English.`;
const introduction = isRelationships
  ? 'From dating and financial red flags to splitting rent, combining finances and planning a future together, explore practical guides to have better money conversations and make fair decisions as a couple.'
  : 'Clear, practical coverage designed to improve financial understanding without hype or false certainty.';
---
<BaseLayout title={`${label} | DollarAngle`} description={description}>
{showDrafts && <div class="preview-bar">Editorial preview mode — draft content is visible and is not approved for publication.</div>}
<section class="page-hero"><div class="container"><span class="eyebrow">DollarAngle topic</span><h1>{label}</h1><p>{introduction}</p></div></section>
<section class="section" style="padding-top:10px"><div class="container">{articles.length ? <div class="grid-3">{articles.map((entry, i) => <ArticleCard entry={entry} dark={i % 2 === 0} headingLevel={2} />)}</div> : <div class="empty">No articles have been approved for public release in this topic yet.</div>}</div></section>
</BaseLayout>
