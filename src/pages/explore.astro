---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getVisibleArticles, showDrafts } from '../lib/content';
const articles = await getVisibleArticles();
---
<BaseLayout title="Explore | DollarAngle" description="Explore DollarAngle guides and analysis across personal finance, investing, markets and the economy.">
{showDrafts && <div class="preview-bar">Editorial preview mode — draft content is visible and is not approved for publication.</div>}
<section class="page-hero"><div class="container"><span class="eyebrow">Explore DollarAngle</span><h1>Build better money judgment.</h1><p>Use practical guides for your financial foundation, then layer in market context, economic understanding and investment education.</p><div class="category-filter"><a class="chip active" href="/explore">All</a><a class="chip" href="/topics/personal-finance">Personal Finance</a><a class="chip" href="/topics/investing">Investing</a><a class="chip" href="/topics/markets">Markets</a><a class="chip" href="/topics/economy">Economy</a><a class="chip" href="/topics/real-estate">Real Estate</a><a class="chip" href="/topics/crypto">Crypto</a></div></div></section>
<section class="section" style="padding-top:10px"><div class="container">{articles.length ? <div class="grid-3">{articles.map((entry, i) => <ArticleCard entry={entry} dark={i % 2 === 0} headingLevel={2} />)}</div> : <div class="empty">No articles have been approved for public release yet.</div>}</div></section>
<section id="explained"></section>
</BaseLayout>
