---
import BaseLayout from '../layouts/BaseLayout.astro';
import { editors } from '../data/editors';
const team = [editors['daniel-brooks'], editors['michael-carter'], editors['ethan-walker'], editors['ryan-mitchell']];
---
<BaseLayout title="About | DollarAngle" description="DollarAngle is a financial education and commentary publication built to help ordinary people understand money, markets and the economic forces shaping their lives.">
<section class="page-hero"><div class="container"><span class="eyebrow">About DollarAngle</span><h1>Money should make more sense.</h1><p>DollarAngle is a financial education and commentary publication built to help ordinary people understand money, markets and the economic forces shaping their lives.</p></div></section>
<section class="section" style="padding-top:10px"><div class="container prose-wrap"><article class="prose"><h2>Our mission</h2><p>We want to make useful financial thinking more accessible. That means explaining the basics well, translating major financial stories into real-world consequences, and helping readers develop better judgment rather than chasing predictions.</p><h2>What we cover</h2><p>Personal finance, saving, debt, investing, retirement, markets, the economy, business, real estate, crypto and financial psychology all belong here when they can improve a reader's understanding or decisions.</p><h2>Who we write for</h2><p>DollarAngle is primarily for working adults who are earning, saving and trying to build a stronger financial future, not just professional investors or finance insiders.</p><h2>What we are not</h2><p>We are not a personalized financial-advice service. We do not promise returns, sell certainty or treat speculation as a shortcut to wealth.</p><h2>Editorial bylines</h2><p>DollarAngle uses consistent editorial bylines to distinguish coverage areas. These names represent DollarAngle editorial personas rather than independently represented staff biographies.</p><ul>{team.map((editor) => <li><strong>{editor.name}</strong>, {editor.role}. {editor.shortBio}</li>)}</ul></article><aside class="sidebar"><h3>DollarAngle</h3><a href="/about">About</a><a href="/editorial-policy">Editorial Policy</a><a href="/disclaimer">Financial Disclaimer</a><a href="/privacy">Privacy</a><a href="/contact">Contact</a></aside></div></section>
</BaseLayout>
