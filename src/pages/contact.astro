---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact | DollarAngle" description="Contact DollarAngle for editorial feedback, corrections and business inquiries.">
<section class="page-hero"><div class="container"><span class="eyebrow">Contact</span><h1>Talk to DollarAngle.</h1><p>Use this page for corrections, source questions, editorial feedback, partnership inquiries and general messages.</p></div></section>
<section class="section" style="padding-top:10px"><div class="container contact-grid"><div class="contact-card"><h2>What belongs here</h2><p>Corrections, source questions, partnership inquiries and general feedback.</p><p><strong>Financial questions:</strong> DollarAngle cannot provide individualized financial advice through this form.</p><p><strong>Security:</strong> Do not send passwords, account numbers, brokerage credentials or other sensitive financial information.</p></div><form class="contact-form" data-contact-form><label for="name">Name</label><input id="name" name="name" autocomplete="name" maxlength="100" required /><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" maxlength="254" required /><label for="topic">Inquiry type</label><select id="topic" name="topic" required><option value="">Choose one</option><option value="Correction">Correction</option><option value="Editorial feedback">Editorial feedback</option><option value="Source question">Source question</option><option value="Partnership">Partnership</option><option value="General">General</option></select><label for="message">Message</label><textarea id="message" name="message" maxlength="5000" required></textarea><input class="hp-field" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" /><button class="btn btn-primary" type="submit" style="margin-top:18px">Send message</button><p class="form-note" data-contact-status aria-live="polite">Messages are sent to the DollarAngle contact inbox. See our <a href="/privacy">Privacy Policy</a>.</p></form></div></section>
</BaseLayout>
