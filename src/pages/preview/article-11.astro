import BaseLayout from '../../layouts/BaseLayout.astro';
const sections = [
  {title:'1. What is your actual financial situation?', text:'Income is only one part of your financial life. Before major commitments, talk about debts, savings, recurring obligations, and what each person can realistically contribute.'},
  {title:'2. Are we savers, spenders, or a little of both?', text:'Our earliest money experiences shape how we feel about spending and safety. Ask what a comfortable emergency fund means to each of you and which purchases are genuinely worth it.'},
  {title:'3. Should we really split everything 50/50?', text:'Equal is not always equitable. Some couples divide bills evenly, while others contribute in proportion to income. Consider unpaid household work too, and choose an arrangement both partners can sustain.'},
  {title:'4. Joint accounts or separate accounts?', text:'A yours, mine, and ours arrangement can combine a shared household account with individual accounts. The aim is openness about joint obligations without losing individual autonomy.'},
  {title:'5. What happens when life does not follow the plan?', text:'Discuss job loss, emergency savings, insurance and who can access essential financial details if one partner becomes ill. Preparation protects both your practical lives and your peace of mind.'},
  {title:'6. What does financial freedom mean to us?', text:'One person may dream of a larger home while another wants time to travel. Turn those different dreams into a few shared goals, and revisit them during a monthly money date.'},
  {title:'7. What are our financial deal-breakers?', text:'Private spending is not automatically a betrayal, but deliberately concealed debt affecting joint plans can erode trust. Agree when major purchases and borrowing require an open conversation.'}
];
const dialogues = [
  {idx:0,lines:[['Emma','Wait. You still owe $8,000 on your credit card?'],['Daniel',"Yes. But I've been paying it off."],['Emma','We’ve been saving for a house for two years. How did I not know this?'],['Daniel','I was afraid you would be upset.']]},
  {idx:2,lines:[['Sophie','Why am I paying half the rent when you earn almost twice what I make?'],['James','Because we both live here. Isn’t half fair?'],['Sophie','Equal doesn’t always mean fair. I’m using nearly all my spare income.'],['James',"Okay. Let's figure out something that works for both of us."]]},
  {idx:5,lines:[['Olivia','I want us to retire early and travel.'],['Ben','I want to buy a bigger house.'],['Olivia','A bigger house means a bigger mortgage.'],['Ben','And traveling around Europe for six months is free?']]},
  {idx:6,lines:[['Rachel','Is that another delivery?'],['Mark',"It's just a jacket."],['Rachel','You said that about the shoes last week.'],['Mark','Do I need permission to buy myself something?'],['Rachel',"No, but we agreed we'd tackle the credit card debt together."]]}
];
---
<BaseLayout title="7 Money Conversations Every Couple Should Have | DollarAngle" description="Discover seven essential money conversations for couples, from sharing expenses and managing debt to building financial freedom together." noindex={true}>
<div class="preview-banner">EDITORIAL PREVIEW · ARTICLE 11 · NOT PUBLISHED</div>
<section class="article-hero"><div class="container"><span class="eyebrow">COUPLES & MONEY / RELATIONSHIPS</span><h1>Love Is Not a Financial Plan: 7 Money Conversations Every Couple Needs to Have</h1><p class="article-deck">You can share a bed, a home, and a future with someone—and still have no idea what is happening in their bank account.</p><div class="article-meta"><span>DollarAngle Editorial</span><span>·</span><span>October 9, 2026</span><span>·</span><span>9 min read</span></div></div></section>
<div class="hero-art" role="img" aria-label="Editorial illustration of two coffee mugs and a notebook on a warm kitchen table"><div class="hero-art-copy"><span>LOVE / TRUST / MONEY</span><strong>Two people.<br/>One financial future.</strong></div><div class="cups"><span>☕</span><span>☕</span></div></div>
<section class="section"><div class="container article-layout"><article class="article-body">
<p class="lead">It started with a credit card statement. It ended with a conversation they probably should have had three years earlier.</p>
<div class="scene"><div class="scene-head">AT THE KITCHEN TABLE</div>{dialogues[0].lines.map(l=><p><strong>{l[0]}:</strong> “{l[1]}”</p>)}</div>
<p>Sound familiar? Perhaps it is a car loan, an expensive holiday or a shopping habit nobody wants to discuss. The underlying problem is often the same: two people can love each other deeply and still have completely different pictures of their financial lives.</p>
<p>Healthy financial conversations do not have to turn every dinner into a budget meeting. They simply create the trust and clarity needed to build a life together.</p>
{sections.map((s,i)=><section class="topic"><h2 id={`conversation-${i+1}`}>{s.title}</h2><p>{s.text}</p>{dialogues.find(d=>d.idx===i&&i!==0)&&<div class="scene"><div class="scene-head">A FAMILIAR CONVERSATION</div>{dialogues.find(d=>d.idx===i).lines.map(l=><p><strong>{l[0]}:</strong> “{l[1]}”</p>)}</div>}{i===2&&<div class="example"><strong>Example: $2,400 monthly rent</strong><p>When one partner earns $90,000 and the other $45,000, an equal split is $1,200 each. An income-proportional split is $1,600 and $800, respectively. The right answer depends on the couple's circumstances and agreement.</p></div>}</section>)}
<h2>A 30-minute money date worth trying</h2><p>Set aside half an hour. Share a money habit you are proud of, one financial concern, one shared goal, and one concrete step you can take together this month. Listen to understand rather than to win.</p>
<div class="scene"><div class="scene-head">THE SUNDAY QUESTION</div><p><strong>If your partner earned twice as much as you, would you still agree to split every household expense 50/50?</strong></p><p>Next in Couples & Money: <em>He Earns Twice as Much as She Does. Should They Really Split Everything 50/50?</em></p></div>
<p><small>Dialogue scenes are fictional illustrations, not reports of real couples. Financial education only; not personalized financial or legal advice.</small></p></article><aside class="sidebar"><h2>In this article</h2>{sections.map((s,i)=><a href={`#conversation-${i+1}`}>{s.title}</a>)}<h2>Editorial status</h2><p>Article 11 is in review. This page is not indexed or published on the live site.</p></aside></div></section>
</BaseLayout>
