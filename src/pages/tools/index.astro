.browse-head h2{font-family:Georgia,Cambria,serif;font-weight:700;letter-spacing:-.05em}.filter{transition:background .15s,color .15s,border-color .15s}.tools-grid-v2{grid-template-columns:repeat(12,minmax(0,1fr));grid-auto-flow:dense;gap:16px}.tool-card-v2{grid-column:span 4;min-height:340px;border-radius:13px;border-color:#d7e6dd;padding:25px;overflow:hidden;position:relative;box-shadow:none;isolation:isolate}.tool-card-v2.is-featured{grid-column:span 8;background:#c5f1d5;min-height:365px}.tool-card-v2.is-spotlight{grid-column:span 6;background:#103f32;color:white}.tool-card-v2.is-spotlight .card-category,.tool-card-v2.is-spotlight .card-kicker{color:#a0edbf}.tool-card-v2.is-spotlight p{color:#c9e0d2}.tool-card-v2.is-spotlight .detail{background:#ffffff1c;color:#e7f7ec}.tool-card-v2.is-spotlight .card-index{color:#8fb3a0}.tool-card-v2.is-featured h3{max-width:390px;font-size:clamp(1.9rem,3vw,2.75rem);font-family:Georgia,Cambria,serif}.tool-card-v2 .tool-icon{background:#e2f4e9;border-radius:10px;width:47px;height:47px;font-size:26px}.tool-card-v2.is-featured .tool-icon{background:#fff9}.tool-card-v2.is-spotlight .tool-icon{background:#ffffff20;color:#e0ffed}.tool-card-v2 .v2-copy{position:relative;z-index:1}.tool-card-v2 .card-category{margin-top:18px;display:block}.card-kicker{display:block;margin-top:9px;text-transform:uppercase;font-size:.67rem;font-weight:850;letter-spacing:.12em;color:#50826b}.tool-card-v2 h3{margin:7px 0 9px;font-weight:800}.tool-card-v2>p,.tool-card-v2 .v2-copy p{max-width:420px;line-height:1.55;color:#536e60;font-size:.82rem;margin:0}.tool-card-v2 .card-bottom{position:relative;z-index:2;margin-top:auto;padding-top:20px}.tool-card-v2 .card-go{transition:transform .2s}.tool-card-v2:hover .card-go{transform:rotate(45deg)}.v2-visual{pointer-events:none;position:relative;min-height:73px;width:100%;margin-top:18px;display:flex;align-items:center;justify-content:flex-end}.tool-card-v2.is-featured .v2-visual{position:absolute;right:23px;bottom:80px;width:40%;z-index:0}.mock-split{display:flex;flex-wrap:wrap;align-content:center;gap:5px;width:100%;background:#fff;border:1px solid #94d2ab;border-radius:10px;padding:14px;box-shadow:8px 11px 0 #8fd5aa}.mock-split>span{height:18px;background:#087c61;border-radius:4px}.mock-split>span+span{background:#89d7ad}.mock-split small{font-size:.62rem;flex:1;white-space:nowrap;color:#537466}.mock-split b{color:#0e5e43}.mock-debt{width:100%;border-radius:10px;background:#ffffff12;border:1px solid #ffffff27;padding:15px;display:grid;gap:8px}.mock-debt>span,.mock-fire>span,.mock-progress>span{font-size:.6rem;font-weight:850;letter-spacing:.1em}.mock-debt strong{font-size:1.65rem;letter-spacing:.2em;color:#b4ffcd}.mock-debt i{display:block;height:5px;background:linear-gradient(90deg,#bcffd5 75%,#ffffff25 75%);border-radius:4px}.mock-fire{width:100%;padding:5px 12px}.mock-fire svg{height:72px;color:#a5f3be;width:100%}.mock-progress{background:#eaf6ef;padding:15px;border-radius:10px;width:100%;display:grid;gap:8px;color:#24543f}.mock-progress>div{height:10px;background:#c7e9d3;border-radius:9px;overflow:hidden}.mock-progress i{display:block;width:72%;height:100%;background:#087c61}.mock-progress strong{font-size:.78rem}.mock-glyph{display:flex;width:100%;align-items:center;justify-content:space-between}.mock-glyph span{font:700 56px/1 Georgia,serif;color:#b0d9c1;opacity:.85}.mock-glyph i{height:35px;width:13%;background:#e5f5e9;border-radius:5px;transform:skewY(-20deg)}.mock-glyph i:nth-of-type(2){height:55px;background:#bee7d0}.mock-glyph i:nth-of-type(3){height:42px;background:#83c7a6}.tool-card-v2[hidden]{display:none!important}
