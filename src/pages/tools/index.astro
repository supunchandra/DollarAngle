---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Free Money Calculators for Couples | DollarAngle Money Tools" description="Explore DollarAngle's free money tools for couples. Calculate income-based rent splits and build a Mine, Yours, Ours joint budget. No account or email required.">
  <div class="container tools-hub"><p class="kicker">DOLLARANGLE MONEY TOOLS</p><h1>Money decisions, made clearer.</h1><p class="deck">Practical, interactive tools for couples and families. Calculate together, compare scenarios, and make a plan you both understand.</p><div class="tool-list"><a class="tile" href="/tools/rent-split-calculator"><span class="symbol" aria-hidden="true">↗</span><span class="eyebrow">AVAILABLE · FREE</span><h2>Proportional Rent & Bill Splitter</h2><p>See how 50/50, income-based and hybrid cost sharing change what each partner pays.</p><span class="action">Open calculator →</span></a><a class="tile" href="/tools/mine-yours-ours-budget-calculator"><span class="symbol" aria-hidden="true">◎</span><span class="eyebrow">AVAILABLE · FREE</span><h2>Mine, Yours, Ours Budget Allocator</h2><p>Design a fair three-account plan for shared bills, savings and personal spending.</p><span class="action">Open calculator →</span></a></div><p class="foot">More DollarAngle Money Tools are being developed. No login or email is required to use the available calculators.</p></div>
</BaseLayout>
<style>.tools-hub{padding-top:64px;padding-bottom:100px}.tools-hub>.kicker{color:#087c61}.tools-hub h1{font-size:clamp(2.5rem,6vw,4.8rem);letter-spacing:-.055em;line-height:1.1;margin:10px 0}.deck{max-width:720px;font-size:1.12rem;line-height:1.7;color:#6e6671}.tool-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:18px;margin-top:38px}.tile{position:relative;display:flex;flex-direction:column;align-items:start;padding:30px;border:1px solid #d7e9df;border-radius:25px;background:linear-gradient(135deg,#fff,#f2faf5);min-height:290px;box-shadow:0 12px 35px #0c594c0b;transition:transform .2s ease}.tile:hover{transform:translateY(-3px)}.symbol{display:grid;place-items:center;width:48px;height:48px;border-radius:14px;background:#e0f3ea;color:#087c61;font-size:26px}.eyebrow{font-weight:850;font-size:.7rem;letter-spacing:.1em;color:#087c61;margin-top:22px}.tile h2{font-size:1.6rem;letter-spacing:-.035em;line-height:1.2;margin:10px 0}.tile p{line-height:1.6;color:#60766e}.action{margin-top:auto;color:#087c61;font-weight:800}.foot{font-size:.86rem;color:#766d74;margin-top:30px}@media(max-width:650px){.tools-hub{padding-top:35px}}</style>